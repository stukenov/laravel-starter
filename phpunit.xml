<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Feature"
>
    <testsuites>
        <!-- RULE(tests): three levels, and `tests/Unit` is not one of them.
             The upstream starter's ExampleTest went with the demo content,
             which left this suite pointing at a directory git does not
             carry — an empty one is not a file, so it survived only on the
             machine that deleted it. A fresh clone answers "Test directory
             tests/Unit not found" and runs nothing at all. -->
        <!-- RULE(tests): MakeFeatureTest is excluded from the default run,
             and that is a trade rather than neglect.

             It exercises the generator for real: it writes models,
             controllers and pages, and appends to the shared
             `routes/dash.php`, `routes/api.php`, `Ability.php` and the
             sidebar, cleaning up only at the end. Two consequences, both
             met the first time somebody built on this starter:

             - it takes eleven of the twelve minutes a full run costs, so
               the ordinary edit-test loop stops being usable;
             - a run killed halfway leaves the repository holding whole
               generated entities — twenty-six files of code nobody wrote,
               which only a failing build made visible.

             So the everyday suite is fast and touches nothing, and the
             generator is run on purpose:

                 php artisan test        the fast suite
                 composer test:generator the generator, by testsuite name
                 composer test           both, plus lint and static analysis

             Run the generator suite before shipping anything that touches
             `make:feature`, its stubs, or the conventions it relies on.
             `defaultTestSuite` above is what makes the split real: without
             it PHPUnit runs every suite and the exclusion does nothing. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/MakeFeatureTest.php</exclude>
        </testsuite>

        <testsuite name="Generator">
            <file>tests/Feature/MakeFeatureTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- RULE(tests): 128M is not enough. matomo/device-detector loads
             large rule tables, and the suite exhausts the default limit
             with a fatal error mid-run — which reads like a broken test
             rather than a memory ceiling. Same fix as phpstan. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- RULE(db): tests run against a real PostgreSQL, not SQLite.
             Otherwise uuidv7(), citext and timestamptz go unverified and
             the difference surfaces in production. See AGENTS.md -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="laravel_starter_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
