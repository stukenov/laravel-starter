import { Head, router } from '@inertiajs/react';
import { Search } from 'lucide-react';
import { useEffect, useState } from 'react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { useTranslations } from '@/hooks/use-translations';
import { index } from '@/routes/dash/{{ kebabPlural }}';
import RecordForm, { type {{ studly }}Row } from './form';

type Props = {
    records: { data: {{ studly }}Row[] };
    search: string;
};

/**
 * Convention: a list is a list. Creating and editing live in a dialog
 * because the form is short. See AGENTS.md.
 */
export default function {{ studlyPlural }}Index({ records, search }: Props) {
    const t = useTranslations();

    const [term, setTerm] = useState(search);
    const [editing, setEditing] = useState<{{ studly }}Row | null>(null);
    const [creating, setCreating] = useState(false);

    // Debounce: a request per keystroke hammers the server and lets
    // responses arrive out of order.
    useEffect(() => {
        if (term === search) {
            return;
        }

        const timer = setTimeout(() => {
            router.get(index().url, term ? { search: term } : {}, {
                preserveState: true,
                replace: true,
            });
        }, 300);

        return () => clearTimeout(timer);
    }, [term, search]);

    return (
        <>
            <Head title={t('{{ snakePlural }}.title')} />

            <div className="density-panel space-y-4 p-4">
                <div className="flex items-center justify-between gap-3">
                    <div>
                        <h1 className="text-base font-semibold">
                            {t('{{ snakePlural }}.title')}
                        </h1>
                        <p className="text-muted-foreground">
                            {t('{{ snakePlural }}.description')}
                        </p>
                    </div>

                    <div className="flex items-center gap-2">
                        <div className="relative">
                            <Search className="pointer-events-none absolute top-1/2 left-2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                            <Input
                                value={term}
                                onChange={(event) => setTerm(event.target.value)}
                                placeholder={t('{{ snakePlural }}.search')}
                                className="w-56 pl-7"
                                data-test="{{ kebabPlural }}-search"
                            />
                        </div>

                        <Button
                            size="sm"
                            onClick={() => setCreating(true)}
                            data-test="{{ kebabPlural }}-add"
                        >
                            {t('{{ snakePlural }}.add')}
                        </Button>
                    </div>
                </div>

                {records.data.length === 0 ? (
                    <div
                        className="rounded-md border py-12 text-center text-muted-foreground"
                        data-test="{{ kebabPlural }}-empty"
                    >
                        {search
                            ? t('{{ snakePlural }}.empty_search')
                            : t('{{ snakePlural }}.empty')}
                    </div>
                ) : (
                    <div className="overflow-hidden rounded-md border">
                        <div className="flex bg-muted/40 px-3 py-1.5 text-[11px] font-semibold tracking-wide text-muted-foreground uppercase">
                            {{ tableHeaders }}
                        </div>

                        {records.data.map((record) => (
                            <button
                                key={record.id}
                                type="button"
                                onClick={() => setEditing(record)}
                                className="flex w-full items-center gap-3 border-t px-3 py-2 text-left hover:bg-muted/40"
                                data-test="{{ kebabPlural }}-row"
                            >
                                {{ tableCells }}
                            </button>
                        ))}
                    </div>
                )}
            </div>

            <RecordForm
                record={editing}
                open={creating || editing !== null}
                onClose={() => {
                    setCreating(false);
                    setEditing(null);
                }}
            />
        </>
    );
}

{{ studlyPlural }}Index.layout = {
    breadcrumbs: [{ title: '{{ snakePlural }}.title', href: index() }],
};
