<?php

declare(strict_types=1);

namespace App\Http\Controllers\Dash;

use App\Http\Controllers\Controller;
use App\Http\Requests\{{ studly }}\StoreRequest;
use App\Http\Requests\{{ studly }}\UpdateRequest;
use App\Models\{{ studly }};
{{ relationModelImports }}
use Illuminate\Http\JsonResponse;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class {{ studly }}Controller extends Controller
{
    public function index(Request $request): Response|JsonResponse
    {
        $this->authorize('viewAny', {{ studly }}::class);

        $search = trim((string) $request->query('search', ''));

        // RULE(api): one action, both surfaces — AGENTS.md. The
        // envelope lives on the base controller so the panel and
        // /api/v1 cannot drift apart.
        return $this->page($request, 'dash/{{ kebabPlural }}/index', [
            'records' => {{ studly }}::search($search)
                ->orderByDesc('created_at')
{{ eagerLoad }}
                ->paginate(20)
                ->withQueryString()
                // Not the model itself: a page handed the whole record
                // receives every column added to it later, meant for it
                // or not.
                ->through(fn ({{ studly }} $record) => $record->toPanelItem()),
            'search' => $search,{{ relationOptions }}{{ enumOptions }}
        ], 'records');
    }

    public function store(StoreRequest $request): RedirectResponse|JsonResponse
    {
        $record = {{ studly }}::create($request->validated());

        Inertia::flash('toast', ['type' => 'success', 'message' => __('entities/{{ snakePlural }}.created')]);

        // 201 with the record: the id is the one thing an API caller
        // cannot work out for itself.
        return $this->saved($request, $record->toPanelItem(), 201);
    }

    public function update(UpdateRequest $request, {{ studly }} ${{ snake }}): RedirectResponse|JsonResponse
    {
        ${{ snake }}->update($request->validated());

        Inertia::flash('toast', ['type' => 'success', 'message' => __('entities/{{ snakePlural }}.updated')]);

        // `refresh()` rather than `fresh()`: the same reload of the row,
        // on this instance and typed as one, instead of a new model the
        // signature says might be null.
        return $this->saved($request, ${{ snake }}->refresh()->toPanelItem());
    }

    public function destroy(Request $request, {{ studly }} ${{ snake }}): RedirectResponse|JsonResponse
    {
        $this->authorize('delete', ${{ snake }});

        ${{ snake }}->delete();

        Inertia::flash('toast', ['type' => 'success', 'message' => __('entities/{{ snakePlural }}.deleted')]);

        return $this->saved($request);
    }
}
