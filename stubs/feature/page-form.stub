import { Form, router } from '@inertiajs/react';
import { useEffect, useState } from 'react';
import {{ studly }}Controller from '@/actions/App/Http/Controllers/Dash/{{ studly }}Controller';
import InputError from '@/components/input-error';
import { Button } from '@/components/ui/button';
import { Checkbox } from '@/components/ui/checkbox';
import {
    Dialog,
    DialogContent,
    DialogDescription,
    DialogFooter,
    DialogHeader,
    DialogTitle,
} from '@/components/ui/dialog';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { destroy } from '@/routes/dash/{{ kebabPlural }}';
import { Textarea } from '@/components/ui/textarea';
import { useTranslations } from '@/hooks/use-translations';

export type {{ studly }}Row = {
    id: string;
    {{ tsFields }}
    created_at: string | null;
};

type Props = {
    record: {{ studly }}Row | null;
    open: boolean;
{{ relationOptionProps }}{{ enumOptionProps }}
    onClose: () => void;
};

/**
 * One dialog for both creating and editing: the fields are identical and
 * two near-copies would drift apart.
 */
export default function RecordForm({
    record,
    open,{{ relationOptionDestructure }}{{ enumOptionDestructure }}
    onClose,
}: Props) {
    const t = useTranslations();

    // Armed by the first click on Delete, disarmed whenever the dialog
    // opens again — so a dialog reopened later never starts one click
    // away from removing something.
    const [confirming, setConfirming] = useState(false);

    useEffect(() => setConfirming(false), [open, record?.id]);

    const action = record
        ? {{ studly }}Controller.update.form(record.id)
        : {{ studly }}Controller.store.form();

    return (
        <Dialog open={open} onOpenChange={(next) => !next && onClose()}>
            <DialogContent className="density-panel">
                <DialogHeader>
                    <DialogTitle>
                        {record
                            ? t('{{ snakePlural }}.edit')
                            : t('{{ snakePlural }}.add')}
                    </DialogTitle>
                    <DialogDescription>
                        {t('{{ snakePlural }}.description')}
                    </DialogDescription>
                </DialogHeader>

                <Form
                    {...action}
                    options={{ preserveScroll: true }}
                    onSuccess={onClose}
                    className="space-y-4"
                >
                    {({ errors, processing }) => (
                        <>
                            {{ formFields }}

                            <DialogFooter className="sm:justify-between">
                                {/* The generated controller has a
                                    destroy action, a route and a test
                                    for it, and nothing on screen reached
                                    any of them: a record could be made
                                    and edited and never removed. Only
                                    when editing — there is nothing to
                                    delete while creating. */}
                                {/* Two clicks, not one. Deleting is the
                                    only irreversible thing on this
                                    screen and it used to happen on a
                                    single click, next to Cancel, at 44px
                                    under a thumb. The second click says
                                    what it will do. */}
                                {record ? (
                                    <Button
                                        type="button"
                                        variant="destructive"
                                        size="sm"
                                        className="min-h-11 sm:min-h-8"
                                        onClick={() => {
                                            if (!confirming) {
                                                setConfirming(true);

                                                return;
                                            }

                                            onClose();
                                            router.delete(destroy(record.id));
                                        }}
                                        data-test="{{ snake }}-delete"
                                    >
                                        {confirming
                                            ? t('{{ snakePlural }}.delete_confirm')
                                            : t('{{ snakePlural }}.delete')}
                                    </Button>
                                ) : (
                                    <span />
                                )}

                                {/* RULE(mobile): 44px under a finger,
                                    dense under a cursor. shadcn's `sm`
                                    is 32px, which is a comfortable
                                    target for a mouse and a miss for a
                                    thumb — and these are the two buttons
                                    that finish the job. */}
                                <div className="flex gap-2">
                                    <Button
                                        type="button"
                                        variant="secondary"
                                        size="sm"
                                        className="min-h-11 flex-1 sm:min-h-8 sm:flex-none"
                                        onClick={onClose}
                                    >
                                        {t('{{ snakePlural }}.cancel')}
                                    </Button>
                                    <Button
                                        size="sm"
                                        className="min-h-11 flex-1 sm:min-h-8 sm:flex-none"
                                        disabled={processing}
                                        data-test="{{ snake }}-save"
                                    >
                                        {t('{{ snakePlural }}.save')}
                                    </Button>
                                </div>
                            </DialogFooter>
                        </>
                    )}
                </Form>
            </DialogContent>
        </Dialog>
    );
}
