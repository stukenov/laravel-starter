APP_NAME="Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# RULE(time): the application runs in UTC. A person's zone is users.timezone.
APP_TIMEZONE=UTC

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# RULE(db): pgsql only. The application refuses to boot on another driver.
# Postgres.app keeps its binaries out of PATH:
# /Applications/Postgres.app/Contents/Versions/latest/bin
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_starter
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Registration works and is switched off by this one flag — the routes
# stop existing along with the link to them.
REGISTRATION_ENABLED=true

# Mailpit: brew install mailpit && brew services start mailpit
# Web interface at http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@laravel-starter.test"
MAIL_FROM_NAME="${APP_NAME}"

# Operations. AGENTS.md lists these under "replace when cloning" and none
# of them were here, so nobody working from this file ever saw them.
#
# Every one of them fails silently when left empty: Laravel's mail channel
# returns without sending and without erroring, so a failing disk, queue
# or database alerts nobody, and the only way to find out is to open
# /dash/health by hand.
# Organisations. Off means nothing changes: every table carries a
# nullable tenant_id that stays empty, and the global scope never
# applies. Turn it on and each account sees only its own organisation;
# an account with no organisation is an operator and sees all of them.
TENANCY_ENABLED=false

HEALTH_TO_ADDRESS=
BACKUP_NOTIFICATION_EMAIL=
FAILED_JOB_EMAILS=

# Without this the /health.json route is not registered at all. That is
# deliberate — an open one hands a stranger the list of which parts of the
# system are currently failing. Send it in X-Health-Secret, never in the URL.
HEALTH_JSON_SECRET=

# Empty is right behind nginx→PHP-FPM, where nginx already passes the real
# client address. Put a CDN or a balancer in front and this must be set, or
# every visitor shares one address: the login limiter becomes one bucket
# for the internet and HSTS quietly stops being sent.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
